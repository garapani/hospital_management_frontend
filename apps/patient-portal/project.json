{
  "name": "patient-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "hms",
  "sourceRoot": "apps/patient-portal/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/patient-portal",
        "browser": "apps/patient-portal/src/main.ts",
        "tsConfig": "apps/patient-portal/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/patient-portal/public"
          }
        ],
        "styles": ["apps/patient-portal/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/patient-portal/src/environments/environment.ts",
              "with": "apps/patient-portal/src/environments/environment.production.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "prebundle": {
          "exclude": ["@org/api-client", "@org/auth"]
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "patient-portal:build:production"
        },
        "development": {
          "buildTarget": "patient-portal:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{projectRoot}/test-output/jest/coverage"],
      "options": {
        "jestConfig": "apps/patient-portal/jest.config.cts",
        "tsConfig": "apps/patient-portal/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "patient-portal:build",
        "port": 4300,
        "staticFilePath": "dist/apps/patient-portal/browser",
        "spa": true
      }
    }
  }
}
