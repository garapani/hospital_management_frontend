{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": "../..",
    "declaration": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "../../libs/auth/src/**/*.ts",
    "../../libs/api-client/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/test-setup.ts",
    "../../libs/auth/src/**/*.spec.ts",
    "../../libs/api-client/src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../libs/auth/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api-client/tsconfig.lib.json"
    }
  ]
}
